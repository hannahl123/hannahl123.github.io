---
import Prompt from "./Prompt.astro";
import Bunny from "./Bunny.astro";
import SocialLinks from "./SocialLinks.astro";
import type { Profile } from "../../lib/types";
interface Props { profile: Profile }
const { profile } = Astro.props;
---

<section id="top" class="scroll-mt-24 pt-6">
  <Prompt cmd="whoami" as="p" />
  <div class="mt-4 flex items-start justify-between gap-6">
    <div>
      <h1 class="font-display text-4xl font-bold text-white sm:text-6xl">{profile.name} <span class="text-pink">✿</span></h1>
      <p class="mt-3 text-muted">// {profile.tagline}</p>
      <p class="mt-2"><span class="text-pink">status</span><span class="text-muted">:</span> <span class="text-butter">"{profile.status}"</span></p>
    </div>
    <Bunny class="hidden shrink-0 text-base sm:block" />
  </div>
  <div class="mt-6"><SocialLinks profile={profile} /></div>
</section>
