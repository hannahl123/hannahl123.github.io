---
import Prompt from "./Prompt.astro";
import ProjectCard from "./ProjectCard.astro";
import type { Project } from "../../lib/types";
interface Props { projects: Project[]; total: number }
const { projects, total } = Astro.props;
---

<section id="projects" class="scroll-mt-24">
  <Prompt cmd="ls projects/" />
  <div class="mt-4 grid gap-4 sm:grid-cols-2">{projects.map((p) => <ProjectCard project={p} />)}</div>
  <a href="/projects" class="mt-5 inline-block text-pink underline-offset-4 hover:underline">see all {total} projects →</a>
</section>
