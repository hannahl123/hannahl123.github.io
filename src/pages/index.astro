---
import Base from "../layouts/Base.astro";
import Whoami from "../components/read/Whoami.astro";
import About from "../components/read/About.astro";
import Work from "../components/read/Work.astro";
import Contact from "../components/read/Contact.astro";
import Footer from "../components/read/Footer.astro";
import SectionIndex from "../components/read/SectionIndex.astro";
import Terminal from "../components/terminal/Terminal";
import { loadSiteData } from "../lib/site-data";

const data = await loadSiteData();
const { profile, jobs, lastUpdated } = data;
---

<Base modes description={`${profile.name} — ${profile.tagline}. ${profile.status}.`}>
  <main id="read" class="mx-auto max-w-4xl px-5 pb-4">
    <SectionIndex />
    <div class="space-y-16">
      <Whoami profile={profile} />
      <About paragraphs={profile.about} />
      <Work jobs={jobs} />
      <Contact profile={profile} />
    </div>
    <Footer lastUpdated={lastUpdated} />
  </main>
  <div id="terminal-root" data-requires-js class="mx-auto max-w-4xl px-5">
    <Terminal client:load data={data} />
  </div>
</Base>
